def tls_store_info():
    """Report the ca trust store python3 uses; returns (isEmpty, description)."""
    paths = ssl.get_default_verify_paths()
    try:
        caCount = ssl.create_default_context().cert_store_stats()["x509_ca"]
    except Exception:
        caCount = 0
    desc = ("python3=" + sys.executable + " ca_certs=" + str(caCount)
            + " cafile=" + repr(paths.cafile) + " capath=" + repr(paths.capath))
    return (caCount == 0), desc


def network_error_hint(url, exc):
    """Return a hint for failures to reach the host at all, empty str otherwise."""
    host = urllib.parse.urlparse(url).hostname or url

    # name resolution failed - no dns server reachable, or unknown host
    if isinstance(exc, socket.gaierror):
        return "cannot resolve " + host

    # tls errors are reported by the caller, they mean the host was reached
    if isinstance(exc, ssl.SSLError):
        return ""

    # connect failed or timed out - no route, host down, or blocked
    connectErrnos = (errno.ENETDOWN, errno.ENETUNREACH, errno.ENETRESET,
                     errno.EHOSTDOWN, errno.EHOSTUNREACH, errno.ECONNREFUSED,
                     errno.ECONNRESET, errno.ECONNABORTED, errno.ETIMEDOUT,
                     errno.EPIPE)
    isTimeout = isinstance(exc, (TimeoutError, socket.timeout))
    if isTimeout or (isinstance(exc, OSError) and (exc.errno in connectErrnos)):
        return "cannot connect to " + host

    return ""


def write_https_error(action, url, exc):
    """Log an https failure, with extra guidance for common causes."""
    sys.stderr.write(action + " to " + url + " failed: " + str(exc) + "\n")

    netHint = network_error_hint(url, exc)
    if netHint:
        write_hint(netHint)
        return

    if not isinstance(exc, ssl.SSLCertVerificationError):
        return

    isEmpty, desc = tls_store_info()
    sys.stderr.write("tls trust store: " + desc + "\n")
    if not isEmpty:
        return

    # no ca certificates at all - typically a python.org macos install whose
    # post-install "Install Certificates.command" step was never run
    sys.stderr.write("python3 has no ca certificates installed, cannot verify tls\n")
    frameworkPrefix = "/Library/Frameworks/Python.framework/Versions/"
    openSslCaFile = ssl.get_default_verify_paths().openssl_cafile or ""
    if (sys.platform == "darwin") and openSslCaFile.startswith(frameworkPrefix):
        pyVer = openSslCaFile[len(frameworkPrefix):].split("/")[0]
        sys.stderr.write("run: open \"/Applications/Python " + pyVer
                         + "/Install Certificates.command\"\n")
    else:
        sys.stderr.write("install ca certificates, or point SSL_CERT_FILE at a ca bundle\n")

    # single-line summary for nmail to surface in the ui, see Auth::PerformAction
    write_hint("python3 has no CA certificates, see log.txt")


def redact(value):
    """Shorten a secret (e.g. auth code) to a non-usable form for logging."""
    if len(value) <= 24:
        return "<len=" + str(len(value)) + ">"
    return value[:12] + "..." + value[-8:] + " <len=" + str(len(value)) + ">"


def write_hint(hint):
    """Emit a concise single-line reason for nmail to show in its ui."""
    sys.stderr.write("hint: " + hint + "\n")


# HttpResponse, get() and post() below constitutes a poor man's 'requests' replacement
class HttpResponse:
    def __init__(self, status_code, headers, text):
        self.status_code = status_code
        self.headers = headers
        self.text = text

    def __repr__(self):
        return "HttpResponse(status=" + str(self.status_code) + ")"


def get(url, headers=None):
    if headers is None:
        headers = {}

    # Parse the URL
    parsed_url = urllib.parse.urlparse(url)
    connection = http.client.HTTPSConnection(parsed_url.netloc, timeout=httpTimeoutSec) if parsed_url.scheme == 'https' else http.client.HTTPConnection(parsed_url.netloc, timeout=httpTimeoutSec)

    # Construct the path with query parameters if any
    path = parsed_url.path
    if parsed_url.query:
        path += '?' + parsed_url.query

    # Send the GET request
    connection.request("GET", path, headers=headers)

    # Get the response
    response = connection.getresponse()
    response_data = response.read().decode()

    # Close the connection
    connection.close()

    return HttpResponse(response.status, response.getheaders(), response_data)


def post(url, data, headers=None):
    if headers is None:
        headers = {"Content-Type": "application/json"}

    # Parse the URL
    parsed_url = urllib.parse.urlparse(url)
    connection = http.client.HTTPSConnection(parsed_url.netloc, timeout=httpTimeoutSec) if parsed_url.scheme == 'https' else http.client.HTTPConnection(parsed_url.netloc, timeout=httpTimeoutSec)

    # Encode the data
    if headers.get("Content-Type") == "application/x-www-form-urlencoded":
        if isinstance(data, dict):
            data = urllib.parse.urlencode(data)
        data = data.encode('utf-8')
    elif headers.get("Content-Type") == "application/json":
        if isinstance(data, dict):
            data = json.dumps(data)
        data = data.encode('utf-8')
    else:
        raise ValueError("Unsupported Content-Type")

    # Send the POST request
    connection.request("POST", parsed_url.path, body=data, headers=headers)

    # Get the response
    response = connection.getresponse()
    response_data = response.read().decode()

    # Close the connection
    connection.close()

    return HttpResponse(response.status, response.getheaders(), response_data)


def url_params(params):
    param_list = []
    for param in params.items():
        param_list.append("%s=%s" % (param[0], urllib.parse.quote(param[1], safe="~-._")))
    return "&".join(param_list)


def parse_json_object(text):
    """Parse a json object response body, returns None if it is not one."""
    try:
        obj = json.loads(text)
    except ValueError:
        return None
    return obj if isinstance(obj, dict) else None


def write_invalid_json(action, response):
    """Log a 200 response whose body is not the expected json object."""
    sys.stderr.write(action + " returned invalid json " + repr(response)
                     + " len=" + str(len(response.text))
                     + " body=" + repr(response.text[:200]) + "\n")
    write_hint("unexpected response from server, see log.txt")


def save_tokens(tokenStore, tokenItems):
    # write to a temp file and rename it into place, so that an interrupted
    # write never leaves a truncated token store behind
    tmpPath = tokenStore + ".tmp"
    with open(tmpPath, "w") as tokenFile:
        for key, value in tokenItems:
            tokenFile.write(str(key) + "=" + str(value) + "\n")
    os.replace(tmpPath, tokenStore)


def read_tokens(tokenStore):
    tokens = {}
    if os.path.isfile(tokenStore):
        with open(tokenStore, "r") as tokenFile:
            tokenLines = tokenFile.read().splitlines()
            for tokenLine in tokenLines:
                # skip malformed lines, a missing token is handled by callers
                key, sep, value = tokenLine.partition("=")
                if sep:
                    tokens[key] = value
    return tokens


def html_page(title, text):
    return bytes("<html><head><title>Nmail Oauth2</title></head>"
                 + "<body><h2>" + title + "</h2><p>" + text + "</p></body></html>", "utf-8")


class LocalHTTPServer(socketserver.ThreadingMixIn, HTTPServer):
    """Handle each connection in its own daemon thread, so an idle browser
    connection neither blocks serving the redirect nor server shutdown."""
    daemon_threads = True


def generate(provider, client_id, client_secret, token_store):
    localHostName = "localhost"
    localHostPort = 6880
    redirectPage = "/oauth2nmail"
    redirectUri = "http://" + localHostName + ":" + str(localHostPort) + redirectPage

    # per-attempt state (rfc 6749 csrf protection) and pkce (rfc 7636), so that
    # redirects not belonging to this login attempt are rejected, and so that an
    # intercepted auth code cannot be redeemed without the code verifier
    state = secrets.token_urlsafe(32)
    codeVerifier = secrets.token_urlsafe(64)
    codeChallenge = base64.urlsafe_b64encode(
        hashlib.sha256(codeVerifier.encode("ascii")).digest()).rstrip(b"=").decode("ascii")

    # redirect handling, written by server thread and read by main thread
    redirectResult = {}
    ignoredRedirects = []

    # local web server handling redirect
    class LocalServer(BaseHTTPRequestHandler):
        # browsers (e.g. chrome) may open speculative connections that never
        # send a request, bound the time a handler waits for request data
        timeout = 10

        def log_message(self, format, *args):
            return

        def send_page(self, status, title, text):
            self.send_response(status)
            self.send_header("Content-type", "text/html")
            self.end_headers()
            self.wfile.write(html_page(title, text))

        def do_GET(self):
            parsedPath = urlparse(self.path)
            if parsedPath.path != redirectPage:
                self.send_page(404, "Not found", "")
                return

            if "query" in redirectResult:
                self.send_page(200, "Login already processed",
                               "You may close this browser window now.")
                return

            # url-decode redirect query, the code may contain escaped chars (e.g.
            # microsoft personal account codes ending in %24%24 = $$), which must
            # be decoded before being form-encoded again in the token request
            queryDict = dict(urllib.parse.parse_qsl(parsedPath.query, keep_blank_values=True))
            if queryDict.get("state") != state:
                ignoredRedirects.append(sorted(queryDict.keys()))
                self.send_page(400, "Authentication failed",
                               "Invalid login request state, please retry login from nmail.")
                return

            if "code" in queryDict:
                self.send_page(200, "Authentication successful",
                               "You may close this browser window now.")
            else:
                self.send_page(200, "Authentication failed",
                               "Access was not granted. You may close this browser window now.")

            redirectResult["query"] = queryDict

    # start local server before opening browser, so it is ready for the redirect
    try:
        localServer = LocalHTTPServer((localHostName, localHostPort), LocalServer)
    except OSError as e:
        sys.stderr.write("local redirect server on " + localHostName + ":" + str(localHostPort)
                         + " failed to start: " + str(e) + "\n")
        if e.errno == errno.EADDRINUSE:
            write_hint("port " + str(localHostPort) + " needed for login is in use")
        else:
            write_hint("cannot start local login server, see log.txt")
        return 8

    thread = threading.Thread(target = localServer.serve_forever)
    thread.daemon = True
    thread.start()

    try:
        # open default web browser for user authentication
        params = {}
        params["client_id"] = client_id
        params["redirect_uri"] = redirectUri
        params["scope"] = providers[provider]["auth_scope"]
        params["response_type"] = "code"
        params["state"] = state
        params["code_challenge"] = codeChallenge
        params["code_challenge_method"] = "S256"
        url = providers[provider]["auth_url"] +  "?" + url_params(params)
        try:
            isBrowserOpened = webbrowser.open(url, new = 0, autoraise = True)
        except Exception as e:
            sys.stderr.write("web browser open failed: " + str(e) + "\n")
            isBrowserOpened = False

        if not isBrowserOpened:
            sys.stderr.write("no web browser available to open login url: " + url + "\n")
            write_hint("cannot open web browser for login")
            return 9

        authTimeoutSec = 120
        sys.stderr.write("web browser opened, waiting up to " + str(authTimeoutSec)
                         + " seconds for redirect to " + redirectUri + "\n")
        secs = 0
        try:
            while ("query" not in redirectResult) and (secs < authTimeoutSec):
                time.sleep(1)
                secs = secs + 1
        except KeyboardInterrupt:
            sys.stderr.write("authentication cancelled by user\n")
            write_hint("login cancelled")
            return 130
    finally:
        localServer.shutdown()
        localServer.server_close()

    if ignoredRedirects:
        sys.stderr.write("oauth2 ignored " + str(len(ignoredRedirects))
                         + " redirect(s) with missing or mismatched state, params="
                         + str(ignoredRedirects) + "\n")

    if "query" not in redirectResult:
        if ignoredRedirects:
            sys.stderr.write("authentication failed: no redirect with matching state within "
                             + str(authTimeoutSec) + " seconds\n")
            write_hint("login failed, redirect state mismatch, see log.txt")
        else:
            sys.stderr.write("authentication timeout after " + str(authTimeoutSec)
                             + " seconds: browser did not reach localhost redirect\n")
            write_hint("login timed out after " + str(authTimeoutSec) + " seconds")
        return 2

    queryDict = redirectResult["query"]
    sys.stderr.write("oauth2 redirect after " + str(secs) + " seconds: params="
                     + str(sorted(queryDict.keys())) + " state=verified pkce=S256\n")
    if "code" not in queryDict:
        err = queryDict.get("error", "?")
        desc = queryDict.get("error_description", "")
        sys.stderr.write("user did not grant permission (error=" + err
                         + " desc=" + desc + ")\n")
        write_hint("access not granted")
        return 3

    code = queryDict["code"]

    # exchange auth code for mail access and refresh token
    convParams = {}
    convParams["client_id"] = client_id
    convParams["code"] = code
    convParams["code_verifier"] = codeVerifier
    convParams["redirect_uri"] = redirectUri
    convParams["grant_type"] = "authorization_code"
    convParams["scope"] = providers[provider]["mail_scope"]
    if provider == "gmail-oauth2":
        convParams["client_secret"] = client_secret

    convUrl = providers[provider]["conv_url"]
    convHdr = {'Content-Type': 'application/x-www-form-urlencoded'}
    try:
        convResponse = post(convUrl, data=convParams, headers=convHdr)
    except Exception as e:
        write_https_error("token request http post", convUrl, e)
        return 4

    if convResponse.status_code != 200:
        sys.stderr.write("token request failed " + repr(convResponse) + "\n")
        sys.stderr.write("response: " + convResponse.text + "\n")
        sys.stderr.write("submitted code: " + redact(code) + "\n")
        sys.stderr.write("submitted code_verifier: " + redact(codeVerifier) + " (S256)\n")
        sys.stderr.write("submitted redirect_uri: " + redirectUri + "\n")
        return 5

    # save tokens
    jsonResponse = parse_json_object(convResponse.text)
    if jsonResponse is None:
        write_invalid_json("token request", convResponse)
        return 5

    save_tokens(token_store, jsonResponse.items())
    tokens = read_tokens(token_store)

    # ensure access_token is present
    if "access_token" in tokens:
        access_token = tokens["access_token"]
    else:
        sys.stderr.write("access_token not in response, keys="
                         + str(sorted(tokens.keys())) + "\n")
        return 6

    # use special access token for outlook user id
    if provider == "outlook-oauth2":
        if "refresh_token" not in tokens:
            sys.stderr.write("refresh_token not in response, keys="
                             + str(sorted(tokens.keys())) + "\n")
            return 7

        # exchange auth code for user info access token
        convParams = {}
        convParams["client_id"] = client_id
        convParams["grant_type"] = "refresh_token"
        convParams["refresh_token"] = tokens["refresh_token"]
        convParams["scope"] = providers[provider]["user_scope"]
        convParams["requested_token_use"] = "on_behalf_of"
        convUrl = providers[provider]["conv_url"]
        convHdr = {'Content-Type': 'application/x-www-form-urlencoded'}
        try:
            convResponse = post(convUrl, data=convParams, headers=convHdr)
        except Exception as e:
            write_https_error("user token request http post", convUrl, e)
            return 4

        if convResponse.status_code != 200:
            sys.stderr.write("user token request failed " + repr(convResponse) + "\n")
            sys.stderr.write("response: " + convResponse.text + "\n")
            return 5

        # ensure user access_token is present, the mail access token above is
        # not valid for the user info request
        jsonResponse = parse_json_object(convResponse.text)
        if jsonResponse is None:
            write_invalid_json("user token request", convResponse)
            return 5

        access_token = str(jsonResponse.get("access_token", ""))
        if not access_token:
            sys.stderr.write("user access_token not in response, keys="
                             + str(sorted(jsonResponse.keys())) + "\n")
            return 6

    # request email address
    infoUrl = providers[provider]["info_url"]
    infoHeaders = {'Authorization': 'Bearer ' + access_token}
    try:
        infoResponse = get(infoUrl, headers=infoHeaders)
    except Exception as e:
        write_https_error("info request http get", infoUrl, e)
        return 4

    if infoResponse.status_code != 200:
        sys.stderr.write("info request failed " + repr(infoResponse) + "\n")
        sys.stderr.write("response: " + infoResponse.text + "\n")
        return 5

    # save user info (email, name)
    jsonInfoResponse = parse_json_object(infoResponse.text)
    if jsonInfoResponse is None:
        write_invalid_json("info request", infoResponse)
        return 5

    emailItems = jsonInfoResponse.items()
    for key, value in emailItems:
        if key == "email" or key == "name":
            tokens[key] = value
        elif key == "userPrincipalName":
            tokens["email"] = value
        elif key == "displayName":
            tokens["name"] = value

    save_tokens(token_store, tokens.items())
    return 0


def refresh(provider, client_id, client_secret, token_store):
    # read token store
    tokens = read_tokens(token_store)

    # ensure refresh_token is present; fall through to a full reauth if not
    # (e.g. missing/empty tokens file) — mirrors the token-expired path below
    if "refresh_token" not in tokens:
        sys.stderr.write("refresh_token not set in " + token_store + "\n")
        sys.stderr.write("attempt to reauthenticate\n")
        return generate(provider, client_id, client_secret, token_store)

    refresh_token = tokens["refresh_token"]

    # use refresh code to request new access token
    refrParams = {}
    refrParams["client_id"] = client_id

    refrParams["refresh_token"] = refresh_token
    refrParams["grant_type"] = "refresh_token"
    if provider == "gmail-oauth2":
        refrParams["client_secret"] = client_secret

    refrUrl = providers[provider]["refr_url"]
    refrHdr = {'Content-Type': 'application/x-www-form-urlencoded'}
    try:
        refrResponse = post(refrUrl, data=refrParams, headers=refrHdr)
    except Exception as e:
        write_https_error("token refresh http post", refrUrl, e)
        return 4

    # parse response - the body is not guaranteed to be json, an intermediate
    # proxy or gateway may return html for 5xx, so tolerate a decode failure
    jsonRefrResponse = parse_json_object(refrResponse.text)
    isJsonValid = jsonRefrResponse is not None
    if not isJsonValid:
        jsonRefrResponse = {}

    # any invalid_grant means the refresh token is no longer usable (expired,
    # revoked, password changed, consent withdrawn) and only a new interactive
    # sign-in can recover, so reauthenticate rather than matching the provider's
    # error_description wording, which varies and is subject to change
    if (refrResponse.status_code == 400) and (jsonRefrResponse.get("error") == "invalid_grant"):
        sys.stderr.write("refresh token no longer valid " + repr(refrResponse) + "\n")
        sys.stderr.write("response: " + refrResponse.text + "\n")
        sys.stderr.write("attempt to reauthenticate\n")
        return generate(provider, client_id, client_secret, token_store)

    if refrResponse.status_code != 200:
        sys.stderr.write("token refresh failed " + repr(refrResponse) + "\n")
        sys.stderr.write("response: " + refrResponse.text + "\n")
        write_hint("mail account authentication failed, see log.txt")
        return 5

    if not isJsonValid:
        write_invalid_json("token refresh", refrResponse)
        return 5

    # save received tokens
    refreshedTokens = jsonRefrResponse.items()
    for key, value in refreshedTokens:
        tokens[key] = value

    save_tokens(token_store, tokens.items())

    # report non-sensitive metadata for diagnostics (output is logged by nmail)
    newAccessToken = str(tokens.get("access_token", ""))
    newRefreshToken = str(tokens.get("refresh_token", ""))
    sys.stderr.write("refresh response: status=" + str(refrResponse.status_code)
                     + " keys=" + str(sorted(jsonRefrResponse.keys()))
                     + " expires_in=" + str(jsonRefrResponse.get("expires_in", "?"))
                     + " ext_expires_in=" + str(jsonRefrResponse.get("ext_expires_in", "?"))
                     + " scope=" + repr(jsonRefrResponse.get("scope", "?"))
                     + " access_token_len=" + str(len(newAccessToken))
                     + " refresh_token_len=" + str(len(newRefreshToken))
                     + " refresh_token_changed=" + str(int(newRefreshToken != refresh_token))
                     + "\n")
    return 0


def main(argv):
    # Global setting
    os.umask(stat.S_IRWXG | stat.S_IRWXO)

    # Process arguments
    if len(sys.argv) != 2:
        show_help()
        sys.exit(1)
    elif (sys.argv[1] == "--help") or (sys.argv[1] == "-h"):
        show_help()
        sys.exit(0)
    elif (sys.argv[1] == "--version") or (sys.argv[1] == "-v"):
        show_version()
        sys.exit(0)

    # Determine operation
    isGenerate = (sys.argv[1] == "--generate") or (sys.argv[1] == "-g")
    isRefresh = (sys.argv[1] == "--refresh") or (sys.argv[1] == "-r")

    if not isGenerate and not isRefresh:
        show_help()
        sys.exit(1)

    # Read required environment variables
    provider = os.getenv("OAUTH2_TYPE")
    if not provider:
        sys.stderr.write("env OAUTH2_TYPE not set\n")
        sys.exit(1)
    elif provider not in providers:
        sys.stderr.write("OAUTH2_TYPE provider " + provider + " not supported\n")
        sys.exit(1)

    client_id = os.getenv("OAUTH2_CLIENT_ID")
    if not client_id:
        sys.stderr.write("env OAUTH2_CLIENT_ID not set\n")
        sys.exit(1)

    client_secret = os.getenv("OAUTH2_CLIENT_SECRET")
    if not client_secret:
        sys.stderr.write("env OAUTH2_CLIENT_SECRET not set\n")
        sys.exit(1)

    token_store = os.getenv("OAUTH2_TOKEN_STORE")
    if not token_store:
        sys.stderr.write("env OAUTH2_TOKEN_STORE not set\n")
        sys.exit(1)

    # Perform requested operation
    if isGenerate:
        rv = generate(provider, client_id, client_secret, token_store)
        sys.exit(rv)
    elif isRefresh:
        rv = refresh(provider, client_id, client_secret, token_store)
        sys.exit(rv)


if __name__ == "__main__":
    main(sys.argv)
